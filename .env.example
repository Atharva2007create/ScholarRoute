SCHOLARROUTE_ENVIRONMENT=development
SCHOLARROUTE_LOG_LEVEL=INFO
SCHOLARROUTE_DATABASE_URL=postgresql+psycopg://scholarroute:scholarroute@localhost:5432/scholarroute
SCHOLARROUTE_DATABASE_POOL_SIZE=5
SCHOLARROUTE_DATABASE_MAX_OVERFLOW=10
SCHOLARROUTE_DATABASE_POOL_TIMEOUT_SECONDS=30
SCHOLARROUTE_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Used only by integration tests. Never point this at production.
SCHOLARROUTE_TEST_DATABASE_URL=postgresql+psycopg://scholarroute:scholarroute@localhost:5432/scholarroute_test

# Phase 8 explanation layer. Keep GEMINI_API_KEY server-side and disabled by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=false
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=500
